+def test_attn_window_limits_context():
+    """With one layer and attn_window=W, the output at t must not depend on tokens before t-W+1."""
+    torch.manual_seed(0)
+    model = build_model(small_cfg(n_layers=1, attn_window=4)).eval()
+    with torch.no_grad():
+        for p in model.parameters():
+            p.add_(0.05 * torch.randn_like(p))
+    x = torch.randint(0, 97, (2, 24))
+    x2 = x.clone()
+    x2[:, :10] = torch.randint(0, 97, (2, 10))           # change only tokens 0..9
+    with torch.no_grad():
+        a, b = model(x), model(x2)
+    assert torch.allclose(a[:, 13:], b[:, 13:], atol=1e-5), "attn_window: tokens outside the window leak in"
+    assert not torch.allclose(a[:, :10], b[:, :10]), "attn_window: model ignores its input"
+
+
+def test_token_conv_starts_as_identity():
+    """Zero-initialized token_conv leaves the model's output unchanged at initialization."""
+    torch.manual_seed(0)
+    plain = build_model(small_cfg())
+    conv = build_model(small_cfg(token_conv=4))
+    conv.load_state_dict(plain.state_dict(), strict=False)
+    x = torch.randint(0, 97, (2, 24))
+    with torch.no_grad():
+        assert torch.allclose(plain(x), conv(x), atol=1e-6)
+
+
+def test_token_conv_receptive_field_and_optimizer_group():
+    """token_conv mixes in exactly the last K-1 positions (none from the future), and its kernel is
+    trained by Adam, not Muon (it is not one of the 2-D hidden matrices)."""
+    from nanolm.models.gpt import TokenConv
+    torch.manual_seed(0)
+    conv = TokenConv(8, 4)
+    with torch.no_grad():
+        conv.weight.normal_()
+    h = torch.randn(1, 20, 8)
+    h2 = h.clone()
+    h2[:, 10] += 1.0                                      # perturb position 10 only
+    with torch.no_grad():
+        d = (conv(h2) - conv(h)).abs().sum(-1)[0]
+    changed = [t for t in range(20) if d[t] > 1e-6]
+    assert changed == [10, 11, 12, 13], changed
+    model = build_model(small_cfg(token_conv=4))
+    conv_ids = {id(b.conv.weight) for b in model.blocks}
+    assert not conv_ids & {id(p) for p in model.matrix_params()}
