+# ================================================================================ token conv
+class TokenConv(nn.Module):
+    """h_t <- h_t + sum_k w_k * h_{t-k}, a causal depthwise convolution over time (kernel K, one weight
+    per channel and offset). Gives every layer a cheap view of the last K-1 tokens before attention,
+    like the short convolution in Gated DeltaNet / Mamba layers. Zero-init: starts as the identity."""
+
+    def __init__(self, dim: int, kernel: int):
+        super().__init__()
+        self.kernel = kernel
+        self.weight = nn.Parameter(torch.zeros(dim, 1, kernel))
+
+    def forward(self, h):
+        x = F.pad(h.transpose(1, 2), (self.kernel - 1, 0))           # (B, D, T + K - 1), pad on the left
+        return h + F.conv1d(x, self.weight.to(h.dtype), groups=h.shape[-1]).transpose(1, 2)
+
+
